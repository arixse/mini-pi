{
  "name": "@minipi/monorepo",
  "version": "1.0.2",
  "description": "Mini Pi —— pnpm workspace 根（不发布；发布的是 packages/cli）",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @minipi/mini-pi run dev",
    "dev:cli": "pnpm --filter @minipi/mini-pi run dev:cli",
    "build:cli": "pnpm --filter @minipi/mini-pi run build:cli",
    "build:web": "pnpm --filter @minipi/client run build:web",
    "build:electron": "pnpm --filter @minipi/client run build:electron",
    "link:cli": "pnpm --filter @minipi/mini-pi run link:cli",
    "dev:client": "pnpm --filter @minipi/client run build:web && pnpm --filter @minipi/client run dev",
    "desktop": "pnpm --filter @minipi/client run build:web && pnpm --filter @minipi/client run build:electron && pnpm --filter @minipi/client run desktop",
    "prepare": "npm run build:cli",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "tsx --tsconfig tsconfig.test.json --test --test-concurrency=4 \"packages/*/src/**/*.test.ts\" \"tests/*.test.ts\"",
    "test:coverage": "tsx --tsconfig tsconfig.test.json --test --test-concurrency=4 --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/shim/*.cjs\" --test-coverage-exclude=\"**/*.tsx\" --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=90 \"packages/*/src/**/*.test.ts\" \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm run test:coverage"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.17.0",
  "type": "module",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
