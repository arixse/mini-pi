{
    "compilerOptions":{
        "target": "es2024",
        "module": "esnext",
        "moduleResolution":"bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include":["src"]
}