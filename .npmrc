electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder 的平台工具链（NSIS / winCodeSign / dmg）是**另一套**下载源，
# 与上面那行各管各的：只配 electron_mirror 的表现是「装依赖飞快，一按打包就不动」。
# 它读的键是 npm_config_* 形式，写在 .npmrc 里由包管理器转成环境变量生效。
electron-builder-binaries-mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
