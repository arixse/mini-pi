{
  "name": "@minipi/client",
  "version": "1.0.2",
  "description": "Mini Pi 客户端：App Server（Express + SSE）与 Web 前端（React + Vite）",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx src/server/entry.ts",
    "serve": "tsx src/server/entry.ts",
    "desktop": "tsx src/electron/desktopEntry.ts",
    "build:web": "vite build",
    "build:electron": "esbuild src/electron/entry.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@minipi/core": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
