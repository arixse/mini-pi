    "build:cli": "esbuild src/entry.ts --bundle --platform=node --target=node22 --outfile=bin/mini-pi-cli.cjs --format=cjs",
    "link:cli": "npm link",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
